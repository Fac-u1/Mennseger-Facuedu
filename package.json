{
  "name": "facuedu-uy-mennseger",
  "version": "1.0.0",
  "private": true,
  "description": "Facuedu.uy Mennseger - Aplicacion Android de mensajeria cifrada E2EE con videollamadas, documentos y asistente multimodal FacuIA.",
  "scripts": {
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --only auth,firestore \"node --test firestore.test.js\"",
    "test:rules:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 node --test firestore.test.js",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "android:assemble": "gradle :app:assembleDebug",
    "android:test": "gradle :app:testDebugUnitTest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
